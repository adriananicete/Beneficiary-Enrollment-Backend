PORT=

DB_SERVER=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

JWT_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_PASSWORD=
SMTP_CLIENT_ID=
SMTP_TENANT_ID=
SMTP_CLIENT_SECRET=

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SMTP_USER=


# DEV ONLY — dapat blangko sa production.
# Pinapatay nito ang TLS certificate verification ng buong proseso 
# kasama ang MSSQL connection at ang email na may dalang temp password.
NODE_TLS_REJECT_UNAUTHORIZED=

NODE_ENV=

CORS_ORIGIN=

# Buong address ng frontend, KASAMA ang http:// o https://.
# Hal. http://192.5.5.122:82 — HINDI 192.5.5.122:82.
#
# Dito binubuo ang link sa bawat email. Kapag walang scheme, gumagana
# pa rin sa Outlook pero tinatanggal ng Gmail ang link sa button.
# Hindi mag-bo-boot ang server kung mali ito. https:// lang sa production.
# Bawal ang ? at #. Tinatanggal nang kusa ang / sa dulo.
APP_URL=

DB_ENCRYPT=
DB_TRUST_SERVER_CERTIFICATE=


# Bilang ng proxy sa harap ng server na ito, o false kung wala.
#
# KAILANGAN SA PRODUCTION. Hindi mag-bo-boot ang server kung wala.
# Puwedeng iwang blangko sa development — false ang magiging halaga,
# gaya ng dating hardcoded.
#
# Ito ang nagtatakda kung ano ang req.ip. Isinusulat siya sa BAWAT
# consent record at siya ang susi ng limang rate limiter. Kung may
# reverse proxy sa production at mali ito, IISANG address ang lalabas
# sa lahat ng consent record — at hindi na iyon mababawi.
#
# HUWAG gawing true. Pinagkakatiwalaan niyon ang X-Forwarded-For na
# galing mismo sa caller, kaya kahit sino ay makapipili ng address na
# itatala sa sarili niyang consent record. Tinatanggihan ito ng env.js.
TRUST_PROXY=


# Path sa server ng PNG o JPEG ng pirma ng signatory sa Certificate of
# Coverage. Opsyonal — kapag blangko, pangalan lang ang lalabas.
#
# HUWAG ilagay ang image sa repo. Totoong pirma ito, at ang kopya sa git
# ay mananatili sa history kahit burahin pa.
CERTIFICATE_SIGNATURE_PATH=